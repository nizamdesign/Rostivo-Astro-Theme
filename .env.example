# Base URL of your Strapi server (no trailing slash), e.g. http://localhost:1337.
# Leave it unset to build from the bundled demo content (src/data/demo-content.json).
STRAPI_URL=
# Optional read-only API token (Strapi: Settings > API Tokens). Leave empty if
# the Public role can read the content (the Strapi project grants this on start).
STRAPI_API_TOKEN=
# Public URL of the deployed site, used for canonical, Open Graph and sitemap URLs
SITE_URL=https://example.com
