---
import '../styles/normalize.css';
import '../styles/framework.css';
import '../styles/rostivo.css';
import '../styles/astro.css';
import SeoMeta from '../components/SeoMeta.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import config from '../config/config.json';

interface Props {
  /** Page title. The site title is appended automatically. Omit on the home page. */
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /**
   * Interaction page ID. The animation runtime in /js/interactions.js looks up each
   * page's scroll, load and hover animations by this ID, so every page keeps its own.
   */
  pageId: string;
  /** Class of the outer wrapper div, or false for none (as on some utility pages). */
  wrapper?: string | false;
  nav?: boolean;
  footer?: boolean;
  /** Structured data (JSON-LD) for the page. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  image,
  type,
  noindex,
  pageId,
  wrapper = 'page-wrapper',
  nav = true,
  footer = true,
  jsonLd,
} = Astro.props;
const { site } = config;

const GOOGLE_FONTS =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Oswald:wght@200;300;400;500;600;700&family=Sora:wght@300;400;500;600;700&display=swap';
---

<!doctype html>
<html data-wf-page={pageId} lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <SeoMeta title={title} description={description} image={image} type={type} noindex={noindex} />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta name="generator" content={Astro.generator} />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <link href={GOOGLE_FONTS} rel="preload" as="style" />
    <script is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href={site.favicon} rel="shortcut icon" type="image/svg+xml" />
    <link href={site.appleTouchIcon} rel="apple-touch-icon" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    {/*
      Google Fonts load after the theme stylesheet, as in the original template,
      so its Oswald faces take precedence over the local fallback files in
      /fonts (Astro always places the bundled CSS last in <head>).
    */}
    <link href={GOOGLE_FONTS} rel="stylesheet" />
    {wrapper ? (
      <div class={wrapper}>
        {nav && <Navbar />}
        <slot />
        {footer && <Footer pageId={pageId} />}
      </div>
    ) : (
      <Fragment>
        {nav && <Navbar />}
        <slot />
        {footer && <Footer pageId={pageId} />}
      </Fragment>
    )}
    <script is:inline>
      // Forms without an endpoint in config.json (data-form-demo) show the
      // template's success message instead of being sent anywhere.
      document.addEventListener(
        'submit',
        function (event) {
          var form = event.target;
          if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-form-demo')) return;
          event.preventDefault();
          event.stopImmediatePropagation();
          var block = form.parentElement;
          var done = block && block.querySelector('.w-form-done');
          if (!done) return;
          form.style.display = 'none';
          done.style.display = 'block';
        },
        true,
      );
    </script>
    <script is:inline src="/js/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="></script>
    <script is:inline src="/js/interactions.js"></script>
  </body>
</html>
