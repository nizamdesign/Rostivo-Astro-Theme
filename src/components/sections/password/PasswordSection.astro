---
import { formAttrs } from '../../../lib/utils';
---

<div class="authentication-content-wrap h-100vh">
  <div class="authentication-page-wrap extra-gap w-password-page w-form">
    <div data-w-id="a99198cd-6253-bc79-1878-f6c40bc3d01d" style="opacity: 0" class="site-logo-wrapper align-left">
      <a href="#" class="site-logo-link w-inline-block"
        ><img
          src="/images/Footer-Logo.svg"
          loading="lazy"
          alt="Footer Logo"
          class="site-logo"
      /></a>
    </div>
    <form
      {...formAttrs('password')}
      id="email-form"
      name="email-form"
      data-name="Email Form"
      class="authentication-content-wrapper w-password-page"
      data-wf-page-id="673d7b49d50138517f6abe67"
      data-wf-element-id="673d7b49d50138517f6abe6c00000000000c"
    >
      <div class="authentication-form-wrapper">
        <div data-w-id="37f78e07-0345-5f67-a77c-30b55da8aa63" style="opacity: 0" class="form-title-text-block"><h2 class="authentication-page-title">Protected Password</h2></div>
        <div class="password-form-block">
          <div data-w-id="6a1d6a6b-51ad-068b-be47-baff5b6e0fc3" style="opacity: 0" class="form-single-field-block">
            <label for="pass" class="form-label w-password-page">Email Address</label
            ><input class="text-field w-password-page w-input" autofocus="true" maxlength="256" name="pass" data-name="field" placeholder="youremail@gmail.com" type="password" id="pass" />
          </div>
          <div data-w-id="6442649a-8ccb-8c9f-0071-764926e6dd8d" style="opacity: 0" class="password-button-wrap">
            <input type="submit" data-wait="Please wait..." class="primary-button tertiary-button w-password-page w-button" value="Submit" />
          </div>
        </div>
      </div>
      <div id="w-node-_603379f3-2812-4225-0667-e1cb473a4064-7f6abe67" data-w-id="603379f3-2812-4225-0667-e1cb473a4064" style="opacity: 0" class="password-image-wrap">
        <img src="/images/Protected-Password-Image-1.png" alt="" class="protected-password-image" />
      </div>
      <div class="w-password-page w-form-fail"><div>Incorrect password. Please try again.</div></div>
    </form>
  </div>
</div>
