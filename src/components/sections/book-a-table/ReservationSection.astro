---
import { formAttrs } from '../../../lib/utils';
---

<section class="hero-section contact">
  <div class="overflow-hidden">
    <div class="contact-section-gap">
      <div class="contact-hero-bg">
        <div class="w-layout-blockcontainer container-default w-container">
          <div class="contact-hero-wrapper">
            <div class="hero-content-block">
              <div data-w-id="3b3b3208-9bca-ab7d-e09c-3f6087edeb9b" style="opacity:0" class="subtitle-block booking">
                <div class="subtitle booking">
                  <div class="dot"></div>
                  <div class="subtitle-text">Book a table</div>
                </div>
              </div>
              <div class="hero-title-block max-w-553">
                <h1 data-w-id="27fa4dfc-4046-cd56-057c-1bb84c88d0de" style="-webkit-transform:translate3d(0, 30%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 30%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 30%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 30%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="contact-hero-title">Reserve Your Table at Rystro</h1>
              </div>
              <div class="hero-description-block max-w-551">
                <p data-w-id="27fa4dfc-4046-cd56-057c-1bb84c88d0e1" style="-webkit-transform:translate3d(0, 30%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 30%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 30%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 30%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="body-text-sm text-color-white-two mobile-middlle">Enjoy an Unforgettable Dining Experience</p>
              </div>
            </div>
            <div data-w-id="cbfd3c23-5e9b-a2a0-0136-7fc679bf44ac" style="opacity:0" class="contact-form-block">
              <div id="Contact-Form" class="contact-form w-form">
                <form id="wf-form-Contact-Form" name="wf-form-Contact-Form" data-name="Contact-Form" {...formAttrs('reservation')} class="form-block" data-wf-page-id="67148b0f39aea195fda3670e" data-wf-element-id="3e8d9436-f4a6-ac0e-10f2-5ab0412f3267">
                  <div class="field-wrapper">
                    <div class="single-field-block"><label for="name" class="form-field-label">Your name</label><input class="form-text-field w-input" maxlength="256" name="name" data-name="Name" placeholder="Your full name" type="text" id="name" required=""></div>
                    <div class="single-field-block"><label for="Phone" class="form-field-label">Your Phone</label><input class="form-text-field w-input" maxlength="256" name="Phone" data-name="Phone" placeholder="Your Phone number" type="tel" id="Phone" required=""></div>
                    <div class="single-field-block"><label for="Date-time" class="form-field-label">Date &amp; time</label><input class="form-text-field w-input" maxlength="256" name="Date-time" data-name="Date &amp; time" placeholder="9.00 pm" type="text" id="Date-time" required=""></div>
                    <div class="single-field-block"><label for="Option-Field" class="form-field-label">number of people</label><select id="Option-Field" name="Option-Field" data-name="Option Field" required="" class="form-text-field option-field w-select">
                        <option value="">5</option>
                        <option value="First">10</option>
                        <option value="Second">15</option>
                        <option value="Third">20</option>
                      </select></div>
                    <div class="form-button-block"><input type="submit" data-wait="Please wait..." class="primary-button form-button w-button" value="Submit"></div>
                  </div>
                </form>
                <div class="success-message w-form-done">
                  <div class="body-text-lg">Thank you! Your submission has been received!</div>
                </div>
                <div class="error-message w-form-fail">
                  <div class="body-text-sm">Oops! Something went wrong while submitting the form.</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
