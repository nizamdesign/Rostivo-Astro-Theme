---
import { formAttrs } from '../../../lib/utils';
---

<section class="authentication-section">
  <div class="authentication-section-bg">
    <div class="w-layout-blockcontainer container-default w-container">
      <div class="authentication-page-wrap">
        <div data-w-id="81789c6f-6331-3c01-7f34-47a2bce142f6" style="opacity:0" class="logo-wrapper">
          <a href="#" class="site-logo-link w-inline-block"><img src="/images/Footer-Logo.svg" loading="lazy" alt="Footer Logo" class="site-logo"></a>
        </div>
        <div class="authentication-content-wrapper">
          <div class="authentication-form-wrapper">
            <div data-w-id="d093418d-ce96-a414-eb95-1dc862787a41" style="opacity:0" class="form-heading-text-wrap">
              <h2 class="authentication-page-title">Sign in to your account</h2>
              <p class="body-text-sm text-color-white-two">Please fill your email and password to login</p>
            </div>
            <div class="sign-in-form-block w-form">
              <form id="email-form" name="email-form" data-name="Email Form" {...formAttrs('signIn')} class="sign-in-form" data-wf-page-id="67148b3c833afa4947f7b1e7" data-wf-element-id="d093418d-ce96-a414-eb95-1dc862787a47">
                <div class="form-field-block-wrapper">
                  <div data-w-id="d093418d-ce96-a414-eb95-1dc862787a52" style="opacity:0" class="form-single-field-block"><label for="Email-2" class="form-label">Email Address</label><input class="text-field w-input" maxlength="256" name="Email-2" data-name="Email 2" placeholder="youremail@gmail.com" type="email" id="Email-2" required=""></div>
                  <div data-w-id="d093418d-ce96-a414-eb95-1dc862787a56" style="opacity:0" class="form-single-field-block">
                    <div class="form-label-block"><label for="Password-2" class="form-label">Password</label>
                      <a href="/user-authentication/forgot-password" class="form-text-button">Forgot your password?</a>
                    </div><input class="text-field w-input" maxlength="256" name="Password-2" data-name="Password 2" placeholder="Enter your password" type="password" id="Password-2" required="">
                  </div>
                  <div class="authentication-button-wrapper">
                    <div data-w-id="d093418d-ce96-a414-eb95-1dc862787a5d" style="opacity:0" class="authentication-button-block"><input type="submit" data-wait="Please wait..." class="primary-button tertiary-button w-button" value="Sign In"></div>
                    <div data-w-id="d093418d-ce96-a414-eb95-1dc862787a5f" style="opacity:0" class="form-button-text">or</div>
                    <div data-w-id="d093418d-ce96-a414-eb95-1dc862787a61" style="opacity:0" class="google-sign-container">
                      <a href="https://www.google.com/forms/about/" class="social-authentication-link w-inline-block">
                        <div class="button-text-2"><img loading="lazy" src="/images/Google-Icon.svg" alt="Google Icon" class="google-icon">
                          <div class="form-button-text">Sign In with Google</div>
                        </div>
                      </a>
                      <div class="sign-in-text">
                        <p class="body-text-sm text-color-white-two">Already have an account?</p>
                        <a href="/user-authentication/sign-up" class="form-text-button">Sign Up</a>
                      </div>
                    </div>
                  </div>
                </div>
              </form>
              <div class="w-form-done">
                <div>Thank you! Your submission has been received!</div>
              </div>
              <div class="w-form-fail">
                <div>Oops! Something went wrong while submitting the form.</div>
              </div>
            </div>
          </div>
          <div id="w-node-d093418d-ce96-a414-eb95-1dc862787a72-47f7b1e7" data-w-id="d093418d-ce96-a414-eb95-1dc862787a72" style="opacity:0" class="sign-in-image-wrap"><img sizes="(max-width: 479px) 94vw, (max-width: 624px) 91vw, (max-width: 991px) 568px, (max-width: 1439px) 42vw, 568px" srcset="/images/Authentication-Image-1-p-500.png 500w, /images/Authentication-Image-1.png 568w" alt="Sign In Image" src="/images/Authentication-Image-1.png" loading="lazy" class="authentication-image"></div>
        </div>
      </div>
    </div>
  </div>
</section>
