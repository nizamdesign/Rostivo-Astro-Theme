---
import { formAttrs } from '../../../lib/utils';
---

<section class="authentication-section">
  <div class="authentication-section-bg automatic-size">
    <div class="w-layout-blockcontainer container-default w-container">
      <div class="authentication-page-wrap">
        <div data-w-id="5c39d139-e49d-5c0e-940e-4af56fe64ed0" style="opacity:0" class="logo-wrapper">
          <a href="#" class="site-logo-link w-inline-block"><img src="/images/Footer-Logo.svg" loading="lazy" alt="Footer Logo" class="site-logo"></a>
        </div>
        <div class="authentication-content-wrapper">
          <div data-w-id="5c39d139-e49d-5c0e-940e-4af56fe64ed4" style="opacity:0" class="authentication-form-wrapper">
            <div data-w-id="5c39d139-e49d-5c0e-940e-4af56fe64ed5" style="opacity:0" class="form-heading-text-wrap">
              <h2 class="authentication-page-title">Create an account</h2>
              <p class="body-text-sm text-color-white-two">Create an account and start using Rystro</p>
            </div>
            <div class="sign-in-form-block w-form">
              <form id="email-form" name="email-form" data-name="Email Form" {...formAttrs('signUp')} class="sign-in-form" data-wf-page-id="67148b30825a5682baef6fa4" data-wf-element-id="5c39d139-e49d-5c0e-940e-4af56fe64edb">
                <div class="form-field-block-wrapper">
                  <div data-w-id="5c39d139-e49d-5c0e-940e-4af56fe64edd" style="opacity:0" class="form-field-block">
                    <div class="form-single-field-block"><label for="Name-6" class="form-label">First Name</label><input class="text-field w-input" maxlength="256" name="Name-6" data-name="Name 6" placeholder="Adam" type="text" id="Name-6" required=""></div>
                    <div class="form-single-field-block"><label for="Name-4" class="form-label">Last Name</label><input class="text-field w-input" maxlength="256" name="Name-2" data-name="Name 2" placeholder="Smith" type="text" id="Name-4" required=""></div>
                  </div>
                  <div data-w-id="5c39d139-e49d-5c0e-940e-4af56fe64ee6" style="opacity:0" class="form-single-field-block"><label for="Email-2" class="form-label">Email Address</label><input class="text-field w-input" maxlength="256" name="Email-2" data-name="Email 2" placeholder="youremail@gmail.com" type="email" id="Email-2" required=""></div>
                  <div data-w-id="5c39d139-e49d-5c0e-940e-4af56fe64eea" style="opacity:0" class="form-single-field-block">
                    <div class="form-label-block"><label for="Password-2" class="form-label">Password</label>
                      <a href="/user-authentication/forgot-password" class="form-text-button">Forgot your password?</a>
                    </div><input class="text-field w-input" maxlength="256" name="Password-2" data-name="Password 2" placeholder="Enter your password" type="password" id="Password-2" required="">
                  </div>
                </div>
                <div class="authentication-button-wrapper">
                  <div data-w-id="5c39d139-e49d-5c0e-940e-4af56fe64ef1" style="opacity:0" class="authentication-button-block"><input type="submit" data-wait="Please wait..." class="primary-button tertiary-button w-button" value="Sign Up"></div>
                  <div data-w-id="5c39d139-e49d-5c0e-940e-4af56fe64ef3" style="opacity:0" class="form-button-text">or</div>
                  <div data-w-id="5c39d139-e49d-5c0e-940e-4af56fe64ef5" style="opacity:0" class="google-sign-container">
                    <a href="https://www.google.com/forms/about/" class="social-authentication-link w-inline-block">
                      <div class="button-text-2"><img loading="lazy" src="/images/Google-Icon.svg" alt="Google Icon" class="google-icon">
                        <div class="form-button-text">Sign In with Google</div>
                      </div>
                    </a>
                    <div class="sign-in-text">
                      <p class="body-text-sm text-color-white-two">Already have an account?</p>
                      <a href="/user-authentication/sign-in" class="form-text-button">Sign In</a>
                    </div>
                  </div>
                </div>
              </form>
              <div class="w-form-done">
                <div>Thank you! Your submission has been received!</div>
              </div>
              <div class="w-form-fail">
                <div>Oops! Something went wrong while submitting the form.</div>
              </div>
            </div>
          </div>
          <div id="w-node-_5c39d139-e49d-5c0e-940e-4af56fe64f06-baef6fa4" data-w-id="5c39d139-e49d-5c0e-940e-4af56fe64f06" style="opacity:0" class="sign-in-image-wrap"><img sizes="(max-width: 479px) 94vw, (max-width: 624px) 91vw, (max-width: 991px) 568px, (max-width: 1439px) 42vw, 568px" srcset="/images/Authentication-Image-p-500.png 500w, /images/Authentication-Image.png 568w" alt="Sign Up Image" src="/images/Authentication-Image.png" loading="lazy" class="authentication-image"></div>
        </div>
      </div>
    </div>
  </div>
</section>
