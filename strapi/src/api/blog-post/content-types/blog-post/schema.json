{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post",
    "description": "Articles shown in the blog sections, the Blog page and each post page."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "date": {
      "type": "datetime",
      "required": true
    },
    "category": {
      "type": "string",
      "maxLength": 60
    },
    "author": {
      "type": "string",
      "maxLength": 120
    },
    "readTime": {
      "type": "string",
      "maxLength": 30
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "content": {
      "type": "blocks"
    },
    "metaDescription": {
      "type": "text"
    }
  }
}
